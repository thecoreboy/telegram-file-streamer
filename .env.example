# ========================================================
# Telegram File Streamer Configuration
# ========================================================

# 1. Telegram API Credentials
# Get them from https://my.telegram.org -> API development tools
API_ID=12345678
API_HASH=abcdef0123456789abcdef0123456789

# 2. Telegram Bot Token
# Get it by creating a new bot with @BotFather on Telegram
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# 3. Telegram Storage Channel ID
# Create a private channel on Telegram, add your bot as an ADMIN with "Post Messages" permission.
# Forward a message from that channel to @userinfobot or @RoseBot to get the channel ID.
# Channel IDs always start with -100 (e.g., -1001234567890).
BIN_CHANNEL=-1001234567890

# 4. Public Base URL
# The public domain where this app is hosted (e.g. your Render, Railway, or VPS URL)
# For local testing, use http://localhost:8000
BASE_URL=http://localhost:8000

# 5. Server Network Binding
HOST=0.0.0.0
PORT=8000
WORKERS=4

# 6. Optional: Authorized User IDs
# Comma-separated Telegram User IDs allowed to use the bot (e.g. 12345678,87654321)
# Leave empty to allow any user who chats with the bot.
AUTH_USERS=

# 7. Secret Key for Link Hashing
SECRET_KEY=telegram-file-streamer-change-this-to-a-random-string

# 8. Keep-alive ping interval in seconds (prevents Render/Koyeb free instances from sleeping)
PING_INTERVAL_SECONDS=300
